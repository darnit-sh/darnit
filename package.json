{
  "name": "darnit",
  "version": "0.2.0-rc.1",
  "description": "Your API integrations, invisibly mended. Detects vendor API changes in the code you actually wrote and opens verified migration PRs.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "darnit": "dist/cli.js"
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "packs/**/change.json",
    "packs/**/rules/**"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darnit-sh/darnit.git"
  },
  "homepage": "https://darnit.sh",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run check && npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:fixtures": "tsx scripts/fixtures.ts",
    "test:e2e": "npm run build && tsx scripts/e2e.ts",
    "corpus": "tsx scripts/corpus.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:fixtures",
    "golden": "npm run build && tsx scripts/golden.ts"
  },
  "dependencies": {
    "@ast-grep/cli": "0.50.0",
    "@ast-grep/lang-python": "0.0.6",
    "@ast-grep/napi": "0.50.0",
    "commander": "15.0.0",
    "yaml": "2.9.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.12.0",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
